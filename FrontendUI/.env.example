# FrontendUI environment configuration

# Base URL for the backend API.
# In local dev with Backend on port 3001 and API base path /api:
REACT_APP_API_BASE=http://localhost:3001/api

# In production behind a reverse proxy where /api is routed to the backend,
# you can omit the host and rely on relative path:
# REACT_APP_API_BASE=/api
